---
interface Props {
  title: string;
  description?: string;
  organization?: string;
  location?: string;
  startDate?: string;
  endDate?: string;
  tags?: string[];
  highlights?: string[];
  // Case-study fields
  problem?: string;
  stack?: string[];
  role?: string;
  outcome?: string;
  links?: { label: string; href: string }[];
  href?: string; // card link (e.g., /projects/slug)
}

import SkillBadge from "./SkillBadge.astro";

const { title, description, organization, location, startDate, endDate, tags, highlights, problem, stack, role, outcome, links, href } = Astro.props;

const dateRange = [startDate, endDate].filter(Boolean).join(" — ");
const displayTags = tags ?? stack;
---

<article class="surface-card-interactive group flex flex-col p-6">
  <div class="flex flex-col gap-1">
    <h3 class="text-sm font-semibold tracking-tight text-neutral-900 group-hover:text-neutral-900">
      {href ? <a href={href} class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{title}</a> : title}
    </h3>
    {(organization || dateRange) && (
      <p class="text-xs text-neutral-500">
        {organization}
        {organization && dateRange && <span class="text-neutral-300"> · </span>}
        {dateRange}
        {location && <span class="text-neutral-300"> · </span>}{location}
      </p>
    )}
  </div>

  {description && <p class="mt-3 text-sm leading-relaxed text-neutral-600">{description}</p>}

  {/* Case-study preview */}
  {(problem || role || outcome) && (
    <dl class="mt-4 grid gap-3 text-sm">
      {problem && <div><dt class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Problem</dt><dd class="mt-1 text-neutral-600">{problem}</dd></div>}
      {role && <div><dt class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Role</dt><dd class="mt-1 text-neutral-600">{role}</dd></div>}
      {outcome && <div><dt class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Outcome</dt><dd class="mt-1 text-neutral-600">{outcome}</dd></div>}
    </dl>
  )}

  {highlights && highlights.length > 0 && (
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-neutral-600 marker:text-neutral-300">
      {highlights.slice(0, 3).map((h) => <li>{h}</li>)}
      {highlights.length > 3 && <li class="list-none text-xs text-neutral-500">+{highlights.length - 3} more — view detail for full list</li>}
    </ul>
  )}

  {displayTags && displayTags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
        {displayTags.map((tag) => <SkillBadge label={tag} />)}
    </div>
  )}

  {links && links.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-3 text-xs">
      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="font-medium text-primary underline-offset-4 hover:underline">{link.label} ↗</a>
      ))}
    </div>
  )}
</article>
