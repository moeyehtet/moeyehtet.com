---
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentPath = (path: string) => currentPath === path;
const desktopLinkClass = "inline-flex items-center rounded-full px-4 py-2 text-sm font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const desktopActiveLinkClass = `${desktopLinkClass} bg-primary-container text-on-primary-container`;
const desktopInactiveLinkClass = `${desktopLinkClass} text-neutral-600 hover:bg-surface-container hover:text-neutral-900`;
const mobileLinkClass = "block rounded-xl px-4 py-3 text-sm font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const mobileActiveLinkClass = `${mobileLinkClass} bg-primary-container text-on-primary-container`;
const mobileInactiveLinkClass = `${mobileLinkClass} text-neutral-700 hover:bg-surface-container`;
---

<nav
  class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-8"
  aria-label="Primary"
>
  <a
    href="/"
    class="text-sm font-semibold tracking-tight text-neutral-900 transition hover:text-primary"
    aria-label="Moe Ye Htet — home"
  >
    Moe Ye Htet
    <span class="hidden font-normal text-neutral-500 sm:inline"> — Automotive Software Engineer</span>
  </a>

  <!-- Desktop links -->
  <div class="hidden items-center gap-8 md:flex">
    <a href="/" aria-current={isCurrentPath("/") ? "page" : undefined} class={isCurrentPath("/") ? desktopActiveLinkClass : desktopInactiveLinkClass}>Home</a>
    <a href="/resume" aria-current={isCurrentPath("/resume") ? "page" : undefined} class={isCurrentPath("/resume") ? desktopActiveLinkClass : desktopInactiveLinkClass}>Resume</a>
    <a href="/projects" aria-current={isCurrentPath("/projects") ? "page" : undefined} class={isCurrentPath("/projects") ? desktopActiveLinkClass : desktopInactiveLinkClass}>Projects</a>
    <a href="/contact" aria-current={isCurrentPath("/contact") ? "page" : undefined} class={isCurrentPath("/contact") ? desktopActiveLinkClass : desktopInactiveLinkClass}>Contact</a>
    <a
      href="/resume.pdf"
      download
      class="button-primary px-4 py-2"
    >
      Download Resume
    </a>
    <button
      type="button"
      data-theme-toggle
      class="inline-flex size-10 items-center justify-center rounded-full border border-outline bg-surface-raised text-neutral-700 transition hover:bg-surface-container focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label="Switch to dark theme"
      title="Switch theme"
    >
      <svg data-theme-icon="light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
      <svg data-theme-icon="dark" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6.5 6.5 0 0 0 8.268 8.268c.344-.215.825-.003.803.401"></path></svg>
    </button>
  </div>

  <!-- Mobile toggle -->
  <button
    type="button"
    id="nav-toggle"
    class="inline-flex items-center justify-center rounded-full p-2 text-neutral-600 transition hover:bg-surface-container hover:text-neutral-900 md:hidden"
    aria-expanded="false"
    aria-controls="nav-mobile"
    aria-label="Toggle navigation"
  >
    <svg
      id="icon-open"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
    >
    <svg
      id="icon-close"
      class="hidden"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
    >
  </button>
</nav>

<!-- Mobile panel -->
<div
  id="nav-mobile"
  class="hidden border-t border-outline/80 bg-surface md:hidden"
  aria-hidden="true"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-1.5 px-6 py-4">
    <a href="/" aria-current={isCurrentPath("/") ? "page" : undefined} class={isCurrentPath("/") ? mobileActiveLinkClass : mobileInactiveLinkClass}>Home</a>
    <a href="/resume" aria-current={isCurrentPath("/resume") ? "page" : undefined} class={isCurrentPath("/resume") ? mobileActiveLinkClass : mobileInactiveLinkClass}
      >Resume</a
    >
    <a href="/projects" aria-current={isCurrentPath("/projects") ? "page" : undefined} class={isCurrentPath("/projects") ? mobileActiveLinkClass : mobileInactiveLinkClass}
      >Projects</a
    >
    <a href="/contact" aria-current={isCurrentPath("/contact") ? "page" : undefined} class={isCurrentPath("/contact") ? mobileActiveLinkClass : mobileInactiveLinkClass}
      >Contact</a
    >
    <a
      href="/resume.pdf"
      download
      class="button-primary mt-2"
      >Download Resume</a
    >
    <button
      type="button"
      data-theme-toggle
      class="button-secondary mt-2 w-full"
      aria-label="Switch to dark theme"
    >
      <svg data-theme-icon="light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
      <svg data-theme-icon="dark" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6.5 6.5 0 0 0 8.268 8.268c.344-.215.825-.003.803.401"></path></svg>
      Toggle theme
    </button>
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-mobile");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const themeToggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const themePreference = window.matchMedia("(prefers-color-scheme: dark)");

  const applyTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    themeToggles.forEach((button) => {
      button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
      button.querySelector('[data-theme-icon="light"]')?.classList.toggle("hidden", theme === "dark");
      button.querySelector('[data-theme-icon="dark"]')?.classList.toggle("hidden", theme === "light");
    });
  };

  applyTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  themeToggles.forEach((button) => {
    button.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      applyTheme(nextTheme);
      try {
        localStorage.setItem("theme", nextTheme);
      } catch {}
    });
  });

  themePreference.addEventListener("change", (event) => {
    let hasSavedPreference = false;
    try {
      hasSavedPreference = localStorage.getItem("theme") !== null;
    } catch {}
    if (!hasSavedPreference) applyTheme(event.matches ? "dark" : "light");
  });

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    panel?.classList.toggle("hidden", expanded);
    panel?.setAttribute("aria-hidden", String(expanded));
    iconOpen?.classList.toggle("hidden", !expanded);
    iconClose?.classList.toggle("hidden", expanded);
  });
</script>
