---
interface Props {
  label: string;
  variant?: "default" | "accent";
}

const { label, variant = "default" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-tight transition",
    variant === "accent"
      ? "border-primary-container bg-primary-container text-on-primary-container"
      : "border-outline bg-surface-container text-neutral-700 hover:border-outline-strong hover:bg-white",
  ]}
>
  {label}
</span>
