---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SkillBadge from "../components/SkillBadge.astro";

const resume = await getCollection("resume");
const skillsEntry = resume.find((e) => e.data.type === "skills");
const skillGroups = (() => {
  if (!skillsEntry?.data.highlights) return [];

  return skillsEntry.data.highlights
    .filter((l) => l.startsWith("Programming:") || l.startsWith("Engineering:"))
    .map((line) => {
      const [cat, rest] = line.split(": ");
      return { category: cat, items: rest ? rest.split(", ").map((s) => s.trim()) : [] };
    });
})();

const experienceTeaser = resume
  .filter((e) => e.data.type === "experience")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 2);

const featuredProjects = resume
  .filter((e) => e.data.type === "project")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 2);

const projectSummaries: Record<string, string> = {
  "RaspNet Protocol Implementation":
    "C-based 4-layer token-ring stack for ATmega nodes — CRC32 error detection, packet framing, and state-machine receiver with ACK/retry for reliable and best-effort delivery.",
  "Digital Wave Synthesizer":
    "Senior design audio synthesizer — ADSR envelope and Class AB amplifier plus Li-Po charger and buck converters, with full EaglePCB layouts for power and audio subsystems.",
};

const experienceSummaries: Record<string, string> = {
  "Project Management Co-officer":
    "Led STEM outreach in Karen State — delivered CS courses to 250+ students across 3 schools, trained volunteer teachers, and produced end-to-end lesson plans, slides, videos, and exercises.",
  "Junior Electrical Engineer":
    "Designed electrical panels and schematics for commercial and industrial sites — coordinated client inspections and led internal training on electrical components.",
};
---

<BaseLayout
  title="Moe Ye Htet — Automotive Software Engineering"
  description="Master's student in Automotive Software Engineering — Automotive Software Developer & Embedded Software Engineer. Based in Chemnitz, Germany."
>
  <!-- Hero  -->
  <section class="relative overflow-hidden">
    <!-- Motif layer -->
    <div class="motif-grid motif-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 lg:py-28">
      <div class="flex flex-col-reverse items-center gap-10 md:flex-row md:items-center md:justify-between">
        <div class="max-w-3xl flex-1">
          <p class="mb-4 text-sm font-medium tracking-wide text-teal-700">MSc Automotive Software Engineering — Technische Universität Chemnitz</p>
          <h1 class="text-4xl font-semibold tracking-tight text-neutral-900 md:text-5xl lg:text-[3.25rem] lg:leading-[1.05]">
            Moe Ye Htet
          </h1>
          <p class="mt-2 text-lg font-medium tracking-tight text-neutral-700 md:text-xl">Automotive Software Engineer</p>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 md:text-xl">
            Building safe, reliable embedded systems for the next generation of vehicles. Focused on 
            <span class="font-medium text-neutral-900"> Embedded Systems</span>, AUTOSAR, and ISO 26262 — with a systems mindset and a bias for clean, testable C/C++.
          </p>
          <p class="mt-8 text-sm tracking-wide text-neutral-500">
            Based in Chemnitz, Germany · Open to internships & working-student roles
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/resume"
              class="inline-flex items-center justify-center rounded-md bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
            >
              View Resume
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-md border border-neutral-200 bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
            >
              Get in touch
            </a>
            <a
              href="/resume.pdf"
              download
              class="inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium text-neutral-600 transition hover:text-neutral-900"
            >
              Download Resume <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
        </div>

        <div class="flex shrink-0 justify-center md:justify-end">
          <img
            src="/profile.jpg"
            alt="Portrait of Moe Ye Htet"
            width="400"
            height="400"
            class="h-44 w-44 rounded-full object-cover object-center ring-1 ring-neutral-200 shadow-sm md:h-48 md:w-48 lg:h-52 lg:w-52"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- At-a-glance -->
  <section class="mx-auto max-w-6xl px-6 py-12 md:px-8">
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Skills teaser -->
      <div class="rounded-lg border border-neutral-100 bg-neutral-50/50 p-6">
        <h2 class="text-sm font-semibold tracking-tight text-neutral-900">Core Skills</h2>
        <div class="mt-3 space-y-3">
          {skillGroups.map((group) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-neutral-500">{group.category}</p>
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <SkillBadge label={item} />
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href="/resume#skills" class="mt-4 inline-flex text-xs font-medium text-teal-700 underline-offset-4 hover:underline">View all skills →</a>
      </div>

      <!-- Experience teaser -->
      <div class="rounded-lg border border-neutral-100 bg-neutral-50/50 p-6">
        <h2 class="text-sm font-semibold tracking-tight text-neutral-900">Experience</h2>
        <div class="mt-3 space-y-5">
          {experienceTeaser.map((entry) => (
            <div>
              <p class="text-sm font-medium text-neutral-900">{entry.data.title}</p>
              <p class="text-xs text-neutral-500">{entry.data.organization} · {entry.data.startDate} — {entry.data.endDate}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">
                {experienceSummaries[entry.data.title] ?? entry.data.highlights?.[0]}
              </p>
            </div>
          ))}
        </div>
        <a href="/resume#experience" class="mt-4 inline-flex text-xs font-medium text-teal-700 underline-offset-4 hover:underline">View all experience →</a>
      </div>

      <!-- Featured Projects -->
      <div class="rounded-lg border border-neutral-100 bg-neutral-50/50 p-6">
        <h2 class="text-sm font-semibold tracking-tight text-neutral-900">Featured Projects</h2>
        <div class="mt-3 space-y-5">
          {featuredProjects.map((project) => (
            <div>
              <p class="text-sm font-medium text-neutral-900">{project.data.title}</p>
              <p class="text-xs text-neutral-500">{project.data.organization} · {project.data.startDate} — {project.data.endDate}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">
                {projectSummaries[project.data.title] ?? project.data.highlights?.[0]}
              </p>
            </div>
          ))}
        </div>
        <a href="/resume#projects" class="mt-4 inline-flex text-xs font-medium text-teal-700 underline-offset-4 hover:underline">All projects →</a>
      </div>
    </div>
  </section>
</BaseLayout>
