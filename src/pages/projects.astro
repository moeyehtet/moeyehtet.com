---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="Projects — Moe Ye Htet"
  description="Selected embedded software, electronics, and systems projects by Moe Ye Htet."
>
  <div class="mx-auto max-w-6xl px-6 py-10 md:px-8 md:py-12">
    <header class="max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">Projects</h1>
      <p class="mt-3 text-base leading-relaxed text-neutral-600">
        Selected work in embedded software, electronics, and systems, with the tools and technical contributions behind each project.
      </p>
    </header>

    <section class="mt-10" aria-labelledby="selected-projects-heading">
      <h2 id="selected-projects-heading" class="sr-only">Selected projects</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            organization={project.data.organization}
            location={project.data.location}
            startDate={project.data.startDate}
            endDate={project.data.endDate}
            tags={project.data.tags}
            highlights={project.data.highlights}
            problem={project.data.problem}
            stack={project.data.stack}
            role={project.data.role}
            outcome={project.data.outcome}
            links={project.data.links}
          />
        ))}
      </div>
      {projects.length === 0 && (
        <p class="mt-8 text-sm text-neutral-600">
          No projects are listed yet. <a href="/contact" class="font-medium text-teal-700 underline-offset-4 hover:underline">Get in touch</a> to learn more about my work.
        </p>
      )}
      <p class="mt-8 text-sm text-neutral-500">
        <a href="/resume#projects" class="font-medium text-teal-700 underline-offset-4 hover:underline">View project details on my resume →</a>
      </p>
    </section>
  </div>
</BaseLayout>
