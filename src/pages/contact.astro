---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const resume = await getCollection("resume");
const meta = resume.find((e) => e.data.type === "meta")?.data;

const email = "moeyehtet96@gmail.com";
const linkedin = "https://linkedin.com/in/moeyehtet";
const location = meta?.location ?? "Chemnitz, Germany";
---

<BaseLayout
  title="Contact — Moe Ye Htet"
  description="Contact Moe Ye Htet — M.Sc. Automotive Software Engineering, Technische Universität Chemnitz. Email, LinkedIn, location."
>
  <div class="mx-auto max-w-6xl px-6 py-10 md:px-8 md:py-12">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">Contact</h1>
      <p class="mt-3 text-base leading-relaxed text-neutral-600">
        Please contact me directly via email or LinkedIn — I typically respond within one business day.
      </p>

      <address class="mt-8 not-italic">
        <div class="space-y-6">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
            <span class="w-20 shrink-0 text-xs font-semibold uppercase tracking-widest text-neutral-500">Email</span>
            <div class="flex items-center gap-2">
              <a href={`mailto:${email}`} class="text-sm font-medium text-teal-700 underline-offset-4 hover:underline">{email}</a>
              <button
                type="button"
                id="copy-email"
                data-email={email}
                class="inline-flex items-center rounded-md border border-neutral-200 bg-white px-2.5 py-1 text-xs font-medium text-neutral-700 transition hover:bg-neutral-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
                aria-label="Copy email address"
              >
                <span id="copy-label">Copy</span>
              </button>
            </div>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
            <span class="w-20 shrink-0 text-xs font-semibold uppercase tracking-widest text-neutral-500">LinkedIn</span>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-teal-700 underline-offset-4 hover:underline">
              linkedin.com/in/moeyehtet <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
            <span class="w-20 shrink-0 text-xs font-semibold uppercase tracking-widest text-neutral-500">GitHub</span>
            <a href="https://github.com/moeyehtet" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-teal-700 underline-offset-4 hover:underline">
              github.com/moeyehtet <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
            <span class="w-20 shrink-0 text-xs font-semibold uppercase tracking-widest text-neutral-500">Location</span>
            <span class="text-sm text-neutral-700">{location}</span>
          </div>
        </div>
      </address>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="mailto:moeyehtet96@gmail.com" class="inline-flex items-center justify-center rounded-md bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">
          Send email
        </a>
        <a href="/resume.pdf" download class="inline-flex items-center justify-center rounded-md border border-neutral-200 bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50">
          Download Resume
        </a>
      </div>


    </div>
  </div>

  <script>
    const btn = document.getElementById("copy-email");
    const label = document.getElementById("copy-label");
    btn?.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email");
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = "Copied!";
        setTimeout(() => { if (label) label.textContent = "Copy"; }, 2000);
      } catch {
        if (label) label.textContent = "Failed";
      }
    });
  </script>
</BaseLayout>
