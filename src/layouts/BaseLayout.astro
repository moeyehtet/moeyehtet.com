---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Moe Ye Htet — Automotive Software Engineering",
  description = "Master's student in Automotive Software Engineering — targeting Automotive Software Developer & Embedded Software Engineer roles. CAN, AUTOSAR, RTOS, ISO 26262.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script is:inline>
      (() => {
        let preference = null;
        try {
          preference = localStorage.getItem("theme");
        } catch {}
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = preference === "light" || preference === "dark"
          ? preference
          : systemPrefersDark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- IBM Plex Sans — engineering/technical feel, subset latin, display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-surface">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-primary focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium focus:text-white"
      >Skip to content</a
    >

    <header class="sticky top-0 z-40 border-b border-outline/80 bg-surface/90 shadow-sm backdrop-blur-md">
      <Nav />
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
